---
import BaseLayout from "../layouts/BaseLayout.astro";

// Reference page — design system tokens and Thomas-style text demo.
// Not linked from the main site; kept as a private reference.
// Visit at: localhost:4321/colors
---

<style>
  .thomas-svg {
    filter: drop-shadow(5px 5px 0 #1A1A1A);
    display: block;
    margin: 0 auto;
  }
</style>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <linearGradient id="dinoGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#FFE066" />
      <stop offset="100%" stop-color="#E89A00" />
    </linearGradient>
  </defs>
</svg>

<BaseLayout title="Paleta de colores - Showcase temporal">
  <main class="w-full max-w-4xl mx-auto px-4 py-6 md:py-10">
    <!-- Header -->
    <header class="mb-10 text-center">
      <p class="font-quicksand text-xs uppercase tracking-widest text-gray-500 mb-2">
        Vista previa temporal
      </p>
      <h1 class="mb-3">
        <svg viewBox="0 0 700 140" class="thomas-svg w-full max-w-xl" role="img" aria-label="Paleta de Dino">
          <text x="350" y="100" font-family="'Lilita One', 'Fredoka', cursive" font-size="90" font-weight="400" text-anchor="middle" fill="white" stroke="white" stroke-width="14" stroke-linejoin="round" paint-order="stroke fill">Paleta de Dino</text>
          <text x="350" y="100" font-family="'Lilita One', 'Fredoka', cursive" font-size="90" font-weight="400" text-anchor="middle" fill="url(#dinoGrad)" stroke="#8B5A00" stroke-width="6" stroke-linejoin="round" paint-order="stroke fill">Paleta de Dino</text>
        </svg>
      </h1>
      <p class="font-quicksand text-gray-600 max-w-md mx-auto">
        Colores y tipografía extraídos de la referencia Thomas & Friends. Revisá y decime si vamos bien.
      </p>
    </header>

    <!-- Locomotoras -->
    <section class="mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-2xl" aria-hidden="true">🚂</span>
        <h2
          class="text-2xl"
          style="font-family: 'Fredoka', sans-serif; font-weight: 700; color: #1A1A1A;"
        >
          Locomotoras
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        <article class="rounded-2xl overflow-hidden shadow-lg bg-white">
          <div class="h-28" style="background: linear-gradient(135deg, #2D8FD9 0%, #1A6FAB 100%);"></div>
          <div class="p-4">
            <p class="font-nunito font-bold text-gray-800">tren-azul</p>
            <p class="font-quicksand text-xs text-gray-500 mt-1">#2D8FD9 → #1A6FAB</p>
            <p class="font-quicksand text-xs text-gray-400 mt-1">Thomas · Principal</p>
          </div>
        </article>
        <article class="rounded-2xl overflow-hidden shadow-lg bg-white">
          <div class="h-28" style="background: linear-gradient(135deg, #5BB04A 0%, #3D8B2C 100%);"></div>
          <div class="p-4">
            <p class="font-nunito font-bold text-gray-800">tren-verde</p>
            <p class="font-quicksand text-xs text-gray-500 mt-1">#5BB04A → #3D8B2C</p>
            <p class="font-quicksand text-xs text-gray-400 mt-1">Percy · Success</p>
          </div>
        </article>
        <article class="rounded-2xl overflow-hidden shadow-lg bg-white">
          <div class="h-28" style="background: linear-gradient(135deg, #A86BC4 0%, #7E4A9E 100%);"></div>
          <div class="p-4">
            <p class="font-nunito font-bold text-gray-800">tren-violeta</p>
            <p class="font-quicksand text-xs text-gray-500 mt-1">#A86BC4 → #7E4A9E</p>
            <p class="font-quicksand text-xs text-gray-400 mt-1">Kana · Acentos</p>
          </div>
        </article>
        <article class="rounded-2xl overflow-hidden shadow-lg bg-white">
          <div class="h-28" style="background: linear-gradient(135deg, #D8322B 0%, #A82018 100%);"></div>
          <div class="p-4">
            <p class="font-nunito font-bold text-gray-800">tren-rojo</p>
            <p class="font-quicksand text-xs text-gray-500 mt-1">#D8322B → #A82018</p>
            <p class="font-quicksand text-xs text-gray-400 mt-1">James · CTA</p>
          </div>
        </article>
        <article class="rounded-2xl overflow-hidden shadow-lg bg-white">
          <div class="h-28" style="background: linear-gradient(135deg, #F4C430 0%, #E0A810 100%);"></div>
          <div class="p-4">
            <p class="font-nunito font-bold text-gray-800">tren-amarillo</p>
            <p class="font-quicksand text-xs text-gray-500 mt-1">#F4C430 → #E0A810</p>
            <p class="font-quicksand text-xs text-gray-400 mt-1">Cascos · Highlights</p>
          </div>
        </article>
        <article class="rounded-2xl overflow-hidden shadow-lg bg-white">
          <div class="h-28" style="background: linear-gradient(135deg, #3A3A3A 0%, #1A1A1A 100%);"></div>
          <div class="p-4">
            <p class="font-nunito font-bold text-gray-800">tren-negro</p>
            <p class="font-quicksand text-xs text-gray-500 mt-1">#3A3A3A → #1A1A1A</p>
            <p class="font-quicksand text-xs text-gray-400 mt-1">Humo · Detalles</p>
          </div>
        </article>
      </div>
    </section>

    <!-- Escena -->
    <section class="mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-2xl" aria-hidden="true">🌄</span>
        <h2
          class="text-2xl"
          style="font-family: 'Fredoka', sans-serif; font-weight: 700; color: #1A1A1A;"
        >
          Escena
        </h2>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        <article class="rounded-xl overflow-hidden shadow bg-white">
          <div class="h-20" style="background: #B8E0EE;"></div>
          <div class="p-3">
            <p class="font-nunito font-bold text-sm text-gray-800">cielo-claro</p>
            <p class="font-quicksand text-xs text-gray-500">#B8E0EE</p>
          </div>
        </article>
        <article class="rounded-xl overflow-hidden shadow bg-white">
          <div class="h-20" style="background: #7CC0DC;"></div>
          <div class="p-3">
            <p class="font-nunito font-bold text-sm text-gray-800">cielo-medio</p>
            <p class="font-quicksand text-xs text-gray-500">#7CC0DC</p>
          </div>
        </article>
        <article class="rounded-xl overflow-hidden shadow bg-white">
          <div class="h-20" style="background: #9BC97E;"></div>
          <div class="p-3">
            <p class="font-nunito font-bold text-sm text-gray-800">pasto-claro</p>
            <p class="font-quicksand text-xs text-gray-500">#9BC97E</p>
          </div>
        </article>
        <article class="rounded-xl overflow-hidden shadow bg-white">
          <div class="h-20" style="background: #8B5A2B;"></div>
          <div class="p-3">
            <p class="font-nunito font-bold text-sm text-gray-800">madera</p>
            <p class="font-quicksand text-xs text-gray-500">#8B5A2B</p>
          </div>
        </article>
      </div>
    </section>

    <!-- Tipografía Thomas -->
    <section class="mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-2xl" aria-hidden="true">🔤</span>
        <h2
          class="text-2xl"
          style="font-family: 'Fredoka', sans-serif; font-weight: 700; color: #1A1A1A;"
        >
          Tipografía Thomas
        </h2>
      </div>
      <div
        class="rounded-2xl p-8 md:p-12 text-center"
        style="background: linear-gradient(180deg, #B8E0EE 0%, #ffffff 100%);"
      >
        <div class="mb-3">
          <svg viewBox="0 0 1000 210" class="thomas-svg w-full max-w-4xl" role="img" aria-label="¡Dino cumple 4!">
            <text x="500" y="150" font-family="'Lilita One', 'Fredoka', cursive" font-size="140" font-weight="400" text-anchor="middle" fill="white" stroke="white" stroke-width="22" stroke-linejoin="round" paint-order="stroke fill">¡Dino cumple 4!</text>
            <text x="500" y="150" font-family="'Lilita One', 'Fredoka', cursive" font-size="140" font-weight="400" text-anchor="middle" fill="url(#dinoGrad)" stroke="#8B5A00" stroke-width="8" stroke-linejoin="round" paint-order="stroke fill">¡Dino cumple 4!</text>
          </svg>
        </div>
        <p class="font-quicksand text-sm text-gray-600 mt-6">
          SVG · Lilita One + gradiente interno + outline oscuro + halo blanco unificador + drop shadow
        </p>
      </div>
    </section>

    <!-- Tipografía Body -->
    <section class="mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-2xl" aria-hidden="true">📖</span>
        <h2
          class="text-2xl"
          style="font-family: 'Fredoka', sans-serif; font-weight: 700; color: #1A1A1A;"
        >
          Texto cuerpo
        </h2>
      </div>
      <div class="bg-white rounded-2xl p-6 shadow-md space-y-3">
        <p class="font-nunito text-lg text-gray-800">
          Nunito — la que ya tenés. Legible, amigable, funciona perfecto para un cumple infantil.
        </p>
        <p class="font-quicksand text-base text-gray-600">
          Quicksand — alternativa más suave, ideal para subtítulos y párrafos secundarios.
        </p>
      </div>
    </section>

    <!-- En contexto -->
    <section class="mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-2xl" aria-hidden="true">🎨</span>
        <h2
          class="text-2xl"
          style="font-family: 'Fredoka', sans-serif; font-weight: 700; color: #1A1A1A;"
        >
          En contexto
        </h2>
      </div>
      <div class="bg-white rounded-2xl p-6 shadow-md space-y-6">
        <div>
          <p class="font-quicksand text-xs uppercase tracking-wide text-gray-500 mb-3">Botón CTA (cómo va a quedar el StickyCTA)</p>
          <button
            class="px-8 py-3.5 rounded-full text-white font-bold shadow-lg"
            style="background: linear-gradient(180deg, #D8322B 0%, #A82018 100%); font-family: 'Fredoka', sans-serif; box-shadow: 0 4px 0 #7A1810, 0 6px 12px rgba(0,0,0,0.2);"
          >
            Confirmar asistencia
          </button>
        </div>
        <div>
          <p class="font-quicksand text-xs uppercase tracking-wide text-gray-500 mb-3">Badge / Highlight</p>
          <span
            class="inline-block px-4 py-2 rounded-full text-sm font-bold"
            style="background: linear-gradient(180deg, #F4C430 0%, #E0A810 100%); color: #1A1A1A; font-family: 'Fredoka', sans-serif; box-shadow: 0 2px 0 #B8900A;"
          >
            ¡Quedan 55 días!
          </span>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
