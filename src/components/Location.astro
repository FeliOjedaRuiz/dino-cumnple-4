---
import { ADDRESS, GOOGLE_MAPS_URL, GOOGLE_MAPS_EMBED_URL } from '../lib/config';
import locationBackground from '../Images/fondo-location.png?url';
---

<section
	class="relative w-full md:max-w-2xl md:mx-auto min-h-[550px] md:min-h-[800px] p-6 md:p-12 shadow-none md:shadow-xl overflow-hidden reveal-hidden"
	data-reveal
	aria-label="Ubicación"
>
	<div
		class="absolute inset-0 bg-cover bg-bottom bg-no-repeat pointer-events-none"
		style={`background-image: url('${locationBackground}'); mask-image: linear-gradient(to top, #000 0%, #000 50%, transparent 100%); -webkit-mask-image: linear-gradient(to top, #000 0%, #000 50%, transparent 100%);`}
		aria-hidden="true"
	>
	</div>

	<div class="relative z-10 max-w-xl mx-auto flex flex-col items-center gap-4">
		<!-- Pin + dirección -->
		<div class="flex items-center justify-center md:self-center">
			<svg
				xmlns="http://www.w3.org/2000/svg"
				class="w-6 h-6 shrink-0 text-tren-azul-800"
				fill="currentColor"
				viewBox="0 0 24 24"
				aria-hidden="true"
			>
				<path
					d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z"
				></path>
			</svg>
			<p
				class="font-nunito font-bold text-[clamp(1rem,0.7rem+1.2vw,1.4rem)] text-tren-azul-600 drop-shadow-md"
			>
				{ADDRESS}
			</p>
		</div>

		<!-- Mapa (full-bleed en mobile, polaroid solo en desktop) -->
		<div class="w-full">
			<div
				class="relative w-full h-64 md:h-72 rounded-2xl overflow-hidden md:border-4 md:border-white shadow-xl cursor-pointer group"
			>
				<iframe
					title="Ubicación de D'locos Party"
					tabindex="-1"
					class="pointer-events-none"
					width="100%"
					height="100%"
					style="border: 0;"
					loading="lazy"
					allowfullscreen
					src={GOOGLE_MAPS_EMBED_URL}
				></iframe>
				<a
					href={GOOGLE_MAPS_URL}
					target="_blank"
					rel="noopener noreferrer"
					aria-label="Abrir la ubicación de D'Locosparty en Google Maps"
					class="absolute inset-0 z-10"></a>
			</div>
		</div>
	</div>
</section>
