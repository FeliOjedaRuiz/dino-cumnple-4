---
import { EVENT_DATE_ISO, EVENT_TIME, GOOGLE_MAPS_URL } from '../lib/config';
import { buildGoogleCalendarUrl } from '../lib/calendar';
import percyImg from '../Images/percy-con-vias.png?url';

const date = new Date(EVENT_DATE_ISO + 'T00:00:00');
const dateFormatted = date.toLocaleDateString('es-ES', {
	day: 'numeric',
	month: 'long',
});
---

<section
	class="w-full md:max-w-2xl md:mx-auto p-4 md:p-6 reveal-hidden"
	data-reveal
	aria-label="Detalles del evento"
>
<div class="relative w-full bg-gradient-to-b from-tren-azul-400 to-tren-azul-700 p-6 md:px-12 shadow-xl rounded-xl md:rounded-3xl">
	<img
		src={percyImg}
		alt="Percy"
		class="h-auto object-contain drop-shadow-xl w-52 sm:w-64 md:w-96 absolute bottom-0 left-0 z-0"
	/>

	<div class="flex-1 text-right space-y-4">
		<h2
			class="font-fredoka font-bold text-[clamp(1.7rem,0.8rem+4vw,3.2rem)] text-tren-amarillo-500 drop-shadow-md leading-tight"
		>
			¡Te invito a festejarlo!
		</h2>

		<p
			class="font-nunito font-semibold text-[clamp(0.95rem,0.7rem+1.2vw,1.5rem)] text-tren-amarillo-100"
		>
			El Sábado {dateFormatted}
			<br /> de 17:30 a 21:00hs.
		</p>

		<div class="pt-1">
			<a
				href={GOOGLE_MAPS_URL}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-block font-lilita-one text-[clamp(1rem,0.2rem+4.5vw,2rem)] text-tren-amarillo-500 hover:text-yellow-300 transition-transform hover:scale-105 drop-shadow-[0_2px_4px_rgba(0,0,0,0.4)]"
			>
				en "D'locos Party"
				<p
					class="font-nunito font-semibold text-[clamp(0.8rem,0.6rem+0.7vw,1.15rem)] text-tren-amarillo-100 mt-1"
				>
					Av. Aragón, 3, 18230 Atarfe.
				</p>
			</a>
		</div>
		<a
			href={buildGoogleCalendarUrl()}
			target="_blank"
			rel="noopener noreferrer"
			class="mt-6 inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white hover:bg-gray-50 text-tren-azul-800 font-fredoka font-bold text-[clamp(0.85rem,0.5rem+1.5vw,1.1rem)] shadow-[0_4px_0_#9CA3AF] hover:shadow-[0_2px_0_#9CA3AF] hover:translate-y-0.5 active:translate-y-1 active:shadow-none transition-all duration-150"
			aria-label="Agendar evento en Google Calendar"
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				class="w-5 h-5 shrink-0"
				fill="none"
				viewBox="0 0 24 24"
				stroke="currentColor"
				stroke-width="2.5"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
				<line x1="16" y1="2" x2="16" y2="6"></line>
				<line x1="8" y1="2" x2="8" y2="6"></line>
				<line x1="3" y1="10" x2="21" y2="10"></line>
			</svg>
			Agendar
		</a>

		</div>

	
</section>
