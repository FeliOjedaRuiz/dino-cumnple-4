---
import bgImage from "../Images/hero-background.png?url";
import dinoTitleUrl from "../Images/dino-nube.svg?url";
import cumpleTitleUrl from "../Images/cumple-4.svg?url";
import dateTitleUrl from "../Images/fecha.svg?url";
import Countdown from "./Countdown";
---

<section
  data-entrance
  class="relative w-full bg-no-repeat h-svh md:max-w-2xl md:mx-auto bg-center bg-cover"
  style={`background-image: url('${bgImage}')`}
  aria-label="Invitación"
>
  <!-- Título compuesto por los SVG diseñados para cada línea.
       Outer wrapper does the bounce-in entry. Each SVG has its own drift
       (drift-a / drift-b) so they float around their own origin independently. -->
  <div class="absolute inset-x-0 top-0 z-10 flex flex-col items-center px-4 pt-10 md:pt-14 md:flex-row md:justify-center md:items-center md:gap-2 motion-safe:animate-bounce-in">
    <img
      src={dinoTitleUrl}
      class="block w-[65%] max-w-[23rem] md:w-[35%] md:max-w-[14.5rem] h-auto mb-8 mt-12 motion-safe:animate-drift-a"
      alt="Dino"
    />
    <img
      src={cumpleTitleUrl}
      class="block w-[59%] max-w-[13rem] md:w-[30%] md:max-w-[14.5rem] h-auto -mt-1 motion-safe:animate-drift-b"
      alt="Cumple 4 años"
    />
  </div>

  <!-- Fecha, countdown e indicador de scroll como un único conjunto visual -->
  <div class="absolute inset-x-0 bottom-[clamp(100px,14vh,150px)] z-10 flex flex-col items-center gap-[clamp(0.25rem,1vw,0.75rem)] motion-safe:animate-fade-up" style="animation-delay: 900ms">
    <!-- <img
      src={dateTitleUrl}
      class="block w-[45%] max-w-[15rem] md:w-[29%] md:max-w-[12rem] h-auto mb-1"
      alt="19-09-26"
    /> -->

    <Countdown client:load />

    <!-- Indicador de scroll: texto a la izquierda, flecha a la derecha -->
    <div
      id="hero-scroll-indicator"
      class="mt-6 flex flex-row items-center justify-center gap-1 text-white motion-safe:animate-pulse pointer-events-none"
      style="opacity: 0.85;"
    >
    <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-8 h-8 drop-shadow-[0_2px_6px_rgba(0,0,0,0.6)]"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="6 9 12 15 18 9" />
      </svg>
      <span
        class="font-fredoka font-semibold text-xl md:text-2xl drop-shadow-[0_2px_6px_rgba(0,0,0,0.6)] uppercase"
      >
        desliza para ver más
      </span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-8 h-8 drop-shadow-[0_2px_6px_rgba(0,0,0,0.6)]"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="6 9 12 15 18 9" />
      </svg>
    </div>
  </div>
</section>

<script>
  // The entrance animations behind the cover are frozen by CSS
  // (body:not(.invitation-open) [data-entrance] *) and resume exactly once
  // when Cover.astro adds body.invitation-open on "Abrir". They never replay
  // on scroll-back.
  //
  // This script only fades the scroll indicator once the hero is scrolled past.
  function initHeroObserver() {
    const indicator = document.getElementById("hero-scroll-indicator");
    const hero = document.querySelector<HTMLElement>(
      "section[aria-label='Invitación']",
    );
    if (!hero || !indicator) return;

    const indicatorObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const heroVisible = entry.isIntersecting;
          indicator.style.opacity = heroVisible ? "0.85" : "0";
          indicator.style.transition = "opacity 400ms ease";
        }
      },
      { threshold: 0.1 },
    );
    indicatorObserver.observe(hero);
  }

  document.addEventListener("astro:page-load", initHeroObserver);
</script>
