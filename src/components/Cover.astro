---
import musicUrl from "../music/background-music.mp3?url";
// Placeholder: reemplazar por la foto real de Dino cuando esté disponible.
import coverImg from "../Images/Dino.png?url";
import coverAnimationUrl from "../animations/cover-background.json?url";
---

<!-- Portada inicial: cubre toda la web hasta que el usuario hace clic en "Abrir".
     Este clic califica como interacción del usuario, por lo que el audio puede
     reproducirse sin ser bloqueado por el navegador. -->
<div
  id="cover"
  class="fixed inset-0 z-[100] flex flex-col items-center justify-center gap-6 px-6 overflow-hidden touch-none overscroll-none"
>
  <!-- Lottie background layer -->
  <div
    id="cover-animation"
    data-animation-path={coverAnimationUrl}
    class="absolute inset-0 z-0 overflow-hidden bg-[#eff9fc] pointer-events-none"
    aria-hidden="true"
  ></div>

  <!-- Readability layer over the animation -->
  <div class="absolute inset-0 z-[1] bg-[#eff9fc]/35 pointer-events-none" aria-hidden="true"></div>

  <div class="relative z-10 flex flex-col items-center gap-4 text-center max-w-sm">
    <p
      class="font-fredoka font-bold text-3xl md:text-4xl text-tren-amarillo-700 leading-tight mb-12 motion-safe:animate-cover-title-in"
    >
      <span class="inline-block motion-safe:animate-cover-title-float uppercase drop-shadow-md">
        ¡Tienes una <br /> invitación especial!
      </span>
    </p>

    <div class="motion-safe:animate-cover-photo-float">
      <img
        src={coverImg}
        alt="Dino"
        class="w-64 md:w-80 h-64 md:h-80 object-cover rounded-full shadow-xl bg-gradient-to-b from-tren-azul-100 to-tren-azul-300 border-8 border-tren-azul-700 motion-safe:animate-cover-photo-in"
      />
    </div>
  </div>

  <div class="relative z-10 mt-12 motion-safe:animate-cover-button-float">
    <button
      id="cover-open"
      type="button"
      class="px-8 py-2 rounded-2xl bg-gradient-to-b from-tren-verde-400 to-tren-verde-700 text-white font-fredoka font-bold text-2xl shadow-[0_4px_0_#194714] hover:shadow-[0_2px_0_#194714] hover:translate-y-0.5 active:translate-y-1 active:shadow-none transition-all duration-150 whitespace-nowrap motion-safe:animate-cover-button-in"
    >
      Abrir
    </button>
  </div>
</div>

<script>
  import lottie from "lottie-web";

  const animationContainer = document.getElementById("cover-animation");
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (animationContainer && !prefersReducedMotion) {
    const animationPath = animationContainer.dataset.animationPath;

    if (animationPath) {
      lottie.loadAnimation({
        container: animationContainer,
        renderer: "svg",
        loop: true,
        autoplay: true,
        path: animationPath,
        rendererSettings: {
          preserveAspectRatio: "xMidYMid slice",
        },
      });
    }
  }
</script>

<audio
  id="bg-music"
  class="hidden"
  src={musicUrl}
  preload="metadata"
  aria-hidden="true"
></audio>

<!-- Toggle de música: aparece solo después de abrir la portada.
     Usa SVG inline para garantizar renderizado correcto en todos los navegadores. -->
<button
  id="music-toggle"
  type="button"
  class="fixed top-4 right-4 z-50 inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/30 bg-white/30 text-white shadow-md backdrop-blur-sm transition-all duration-150 hover:scale-105 hover:bg-white/50 active:scale-95 opacity-0 pointer-events-none"
  aria-label="Silenciar música de fondo"
  aria-pressed="false"
  title="Silenciar música de fondo"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect x="6" y="5" width="4" height="14" rx="1"></rect>
    <rect x="14" y="5" width="4" height="14" rx="1"></rect>
  </svg>
</button>

<script>
  const cover = document.getElementById("cover");
  const openBtn = document.getElementById("cover-open");
  const audio = document.getElementById("bg-music") as HTMLAudioElement | null;
  const toggle = document.getElementById("music-toggle");

  if (cover && openBtn && audio && toggle) {
    audio.volume = 0.45;

    // Bloquear scroll completamente mientras la portada está visible
    const html = document.documentElement;
    const originalBodyOverflow = document.body.style.overflow;
    const originalHtmlOverflow = html.style.overflow;
    
    document.body.style.overflow = "hidden";
    html.style.overflow = "hidden";
    html.style.height = "100vh";
    document.body.style.height = "100vh";

    const setToggleState = (playing: boolean) => {
      toggle.setAttribute("aria-pressed", String(playing));
      const label = playing
        ? "Silenciar música de fondo"
        : "Activar música de fondo";
      toggle.setAttribute("aria-label", label);
      toggle.setAttribute("title", label);
    };

    async function playMusic() {
      try {
        await audio.play();
        setToggleState(true);
      } catch {
        // Playback blocked by browser; toggle still available for manual action.
      }
    }

    function pauseMusic() {
      audio.pause();
      setToggleState(false);
    }

    // On desktop (md+) the hero is centered with max-w-2xl, but the toggle
    // is fixed to the viewport. Inset its right edge so it sits inside the
    // hero's right edge — matching the mobile look, where the full-width
    // hero equals the viewport. On mobile, the right-4 class (1rem) already
    // lines up with the hero. The hero's horizontal bounds are constant
    // under vertical scroll, so resize + initial load + openCover is enough.
    function positionMusicToggle() {
      if (!window.matchMedia("(min-width: 768px)").matches) {
        toggle.style.right = ""; // fall back to right-4 (1rem)
        return;
      }
      const hero = document.querySelector<HTMLElement>(
        "section[aria-label='Invitación']",
      );
      if (!hero) return;
      const heroRight = hero.getBoundingClientRect().right;
      // 16px = 1rem of breathing room inside the hero's right edge.
      const rightPx = window.innerWidth - heroRight + 16;
      toggle.style.right = rightPx + "px";
    }
    window.addEventListener("resize", positionMusicToggle);
    positionMusicToggle();

    function openCover() {
      // Recompute now that the toggle is being revealed (fonts/layout may
      // have settled since the initial positionMusicToggle call).
      positionMusicToggle();

      // Lift the freeze: CSS keeps everything behind the cover paused
      // (body:not(.invitation-open) [data-entrance] *) until this click.
      // From here the entrance animations run exactly once, in sync with
      // the cover fade-out. They never replay on scroll-back.
      document.body.classList.add("invitation-open");

      // Fade out the cover so the transition feels soft.
      cover.style.transition = "opacity 0.6s ease-out";
      cover.style.opacity = "0";
      cover.style.pointerEvents = "none";

      // Liberar scroll
      document.body.style.overflow = originalBodyOverflow;
      html.style.overflow = originalHtmlOverflow;
      html.style.height = "";
      document.body.style.height = "";

      // Reveal the music toggle.
      toggle.style.transition = "opacity 0.4s ease-out 0.3s";
      toggle.style.opacity = "1";
      toggle.style.pointerEvents = "auto";

      void playMusic();
    }

    openBtn.addEventListener("click", openCover);

    toggle.addEventListener("click", () => {
      if (audio.paused) {
        void playMusic();
      } else {
        pauseMusic();
      }
    });
  }
</script>
